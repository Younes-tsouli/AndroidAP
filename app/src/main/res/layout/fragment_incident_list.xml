<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 2 — Liste des incidents actifs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:layout_marginTop="25sp">

    <!-- ── Top App Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/app_surface"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <View
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:background="@color/emergency_red"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_summary"
            android:textColor="@color/emergency_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/emergency"
            app:tint="@color/emergency_red" />

    </LinearLayout>

    <!-- ── Label + badge compteur ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/active_incidents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/active_incidents"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary" />

        <TextView
            android:id="@+id/incidents_count_badge"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@color/emergency_red"
            android:gravity="center"
            android:text="@string/placeholder_zero"
            android:textColor="@color/app_on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

    <!-- ── ListView des incidents ── -->
    <!-- Les items sont peuplés par l'adaptateur Java/Kotlin existant -->
    <TextView
        android:id="@+id/empty_incidents_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_active_incidents"
        android:textColor="@color/app_text_secondary"
        android:textSize="18sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/my_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/app_divider"
        android:dividerHeight="3dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
