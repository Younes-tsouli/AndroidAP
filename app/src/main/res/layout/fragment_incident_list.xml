<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 2 — Liste des incidents actifs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:layout_marginTop="25sp">

    <!-- ── Top App Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/app_surface"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <View
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:background="@color/emergency_red"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_summary"
            android:textColor="@color/emergency_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/emergency"
            app:tint="@color/emergency_red" />

    </LinearLayout>

    <!-- ── Label + badge compteur ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/active_incidents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/active_incidents"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary" />

        <TextView
            android:id="@+id/incidents_count_badge"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@color/emergency_red"
            android:gravity="center"
            android:text="@string/placeholder_zero"
            android:textColor="@color/app_on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

    <!-- ── ListView des incidents ── -->
    <!-- Les items sont peuplés par l'adaptateur Java/Kotlin existant -->
    <LinearLayout
        android:id="@+id/summary_status_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:visibility="gone"
        android:baselineAligned="false">

        <FrameLayout
            android:id="@+id/summary_tab_not_sent"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_summary_folder_tab"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="8dp"
                android:paddingEnd="28dp"
                android:text="@string/summary_tab_not_sent"
                android:textColor="@color/summary_folder_tab_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_tab_not_sent_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_summary_tab_badge"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/placeholder_zero"
                android:textColor="@color/emergency_red"
                android:textSize="10sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/summary_tab_sent"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_summary_folder_tab"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="8dp"
                android:paddingEnd="28dp"
                android:text="@string/summary_tab_sent"
                android:textColor="@color/summary_folder_tab_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_tab_sent_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_summary_tab_badge"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/placeholder_zero"
                android:textColor="@color/emergency_red"
                android:textSize="10sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/summary_tab_finished"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_summary_folder_tab"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="8dp"
                android:paddingEnd="28dp"
                android:text="@string/summary_tab_finished"
                android:textColor="@color/summary_folder_tab_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_tab_finished_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_summary_tab_badge"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/placeholder_zero"
                android:textColor="@color/emergency_red"
                android:textSize="10sp"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/summary_content_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_summary_folder_panel"
        android:layout_weight="1"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/empty_incidents_message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_active_incidents"
            android:textColor="@color/app_text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/my_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:paddingStart="0dp"
            android:paddingTop="4dp"
            android:paddingEnd="0dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

    </FrameLayout>

</LinearLayout>
