<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 1 — Détail d'un accident -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true"
    tools:context=".Screen1Fragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Carte principale : icône + titre + description ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/detail_priority_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="#C62828" />

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Titre de l'accident"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textColor="#212121"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description détaillée de ce qui s'est passé..."
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:textColor="#757575"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Section label : Statut ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUT DE L'INTERVENTION"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <!-- ── Carte statut avec RatingBar ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modifier le niveau d'intervention"
                    android:textSize="14sp"
                    android:textColor="#757575" />

                <RatingBar
                    android:id="@+id/detail_rating_status"
                    style="@style/Widget.AppCompat.RatingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1.0"
                    android:progressTint="#C62828"
                    android:secondaryProgressTint="#FFCDD2"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/detail_status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Statut : REPORTED"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#C62828"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Section label : Protocole ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROTOCOLE D'URGENCE"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <!-- ── Carte protocole (fond ambre doux) ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFF8E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    android:layout_marginEnd="14dp"
                    app:tint="#F9A825" />

                <TextView
                    android:id="@+id/detail_safety_protocol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Protocole : ..."
                    android:textSize="14sp"
                    android:textColor="#E65100"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>