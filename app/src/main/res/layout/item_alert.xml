<?xml version="1.0" encoding="utf-8"?>
<!-- Item individuel d'alerte dans la Tour de Contrôle -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/app_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="72dp">

        <!-- Barre de criticité colorée (gauche) -->
        <View
            android:id="@+id/alert_severity_bar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/emergency_red"
            android:minHeight="72dp" />

        <!-- Icône de catégorie -->
        <ImageView
            android:id="@+id/alert_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:padding="8dp"
            android:src="@drawable/ic_menu_alert"
            android:background="@color/severity_critical_surface"
            app:tint="@color/emergency_red" />

        <!-- Texte principal, sous-titre et Spinner de statut -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/alert_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alert_label"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/alert_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/details_label"
                android:textSize="13sp"
                android:textColor="@color/app_text_muted"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3" />

            <!-- ── Spinner de statut (remplace les étoiles) ── -->
            <Spinner
                android:id="@+id/alert_status_spinner"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <!-- Badge de criticité (droite) -->
        <TextView
            android:id="@+id/alert_severity_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:text="@string/level_label"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/app_on_primary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@color/emergency_red" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
