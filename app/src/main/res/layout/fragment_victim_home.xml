<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    tools:context=".screens.VictimHomeFragment">

    <LinearLayout
        android:id="@+id/victim_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.10"
            android:text="ESPACE UTILISATEUR"
            android:textColor="#B71C1C"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_home_user"
            app:tint="#B71C1C" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/victim_center_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/victim_header"
        app:layout_constraintVertical_bias="0.42">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Besoin d'aide ?"
            android:textColor="#212121"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Envoyez une alerte avec votre position automatiquement."
            android:textColor="#616161"
            android:textSize="16sp" />

        <Button
            android:id="@+id/victim_sos_button"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="#B71C1C"
            android:elevation="8dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:stateListAnimator="@null"
            android:text="SOS"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold"
            app:cornerRadius="110dp" />

        <Button
            android:id="@+id/victim_bilan_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#FFFFFF"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="SUIVI"
            android:textColor="#B71C1C"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:strokeColor="#B71C1C"
            app:strokeWidth="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
