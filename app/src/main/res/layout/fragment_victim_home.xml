<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_alt"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    tools:context=".screens.VictimHomeFragment">

    <LinearLayout
        android:id="@+id/victim_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.10"
            android:text="@string/user_space"
            android:textColor="@color/emergency_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_home_user"
            app:tint="@color/emergency_red" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/victim_center_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/victim_header"
        app:layout_constraintVertical_bias="0.42">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/need_help"
            android:textColor="@color/app_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/sos_desc"
            android:textColor="@color/app_text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/victim_sos_button"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="@color/emergency_red"
            android:elevation="8dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:stateListAnimator="@null"
            android:text="@string/sos_button"
            android:textColor="@color/app_on_primary"
            android:textSize="44sp"
            android:textStyle="bold"
            app:cornerRadius="110dp" />

        <Button
            android:id="@+id/victim_bilan_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/app_surface"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="@string/track_button"
            android:textColor="@color/emergency_red"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:strokeColor="@color/emergency_red"
            app:strokeWidth="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
