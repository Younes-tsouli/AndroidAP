<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 4 — Tour de Contrôle (Urgences) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:layout_marginTop="25sp">

    <!-- ── Top App Bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/app_surface"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <View
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:background="@color/emergency_red"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_alerts"
            android:textColor="@color/emergency_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/emergency"
            app:tint="@color/emergency_red" />

    </LinearLayout>

    <!-- ── Label section + badge compteur ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/control_tower"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/realtime_alerts"
                android:textSize="13sp"
                android:textColor="@color/app_text_label"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Badge compteur d'alertes (mis à jour par le Fragment) -->
        <TextView
            android:id="@+id/alerts_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_zero"
            android:textColor="@color/app_on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@color/emergency_red" />

    </LinearLayout>

    <!-- ── État vide (masqué si la liste a des éléments) ── -->
    <LinearLayout
        android:id="@+id/empty_state_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_menu_alert"
            app:tint="@color/app_info_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_active_alerts"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/app_text_disabled"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_operational"
            android:textSize="14sp"
            android:textColor="@color/app_text_disabled"
            android:layout_marginTop="6dp"
            android:textAlignment="center" />

    </LinearLayout>

    <!-- ── Liste des alertes ── -->
    <ListView
        android:id="@+id/alerts_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/app_divider"
        android:dividerHeight="3dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
