<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 3 — Formulaire : Signaler un incident -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Hero header avec image de fond très atténuée ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">





            <!-- Texte header positionné en bas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40sp"
                android:layout_marginLeft="20sp"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signaler un incident"
                    android:textColor="#C62828"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Remplissez les informations ci-dessous"
                    android:textColor="#757575"
                    android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>

        <!-- ── Carte formulaire ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Titre de l'incident -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutTitre"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Titre de l'incident"
                    app:boxStrokeColor="#C62828"
                    app:hintTextColor="#C62828"
                    app:startIconDrawable="@android:drawable/ic_dialog_info"
                    app:startIconTint="#C62828">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Description des faits -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDesc"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Description des faits"
                    app:boxStrokeColor="#C62828"
                    app:hintTextColor="#C62828">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="top"
                        android:inputType="textMultiLine" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section : Environnement -->
                <TextView
                    android:id="@+id/lblEnvironnement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:text="ENVIRONNEMENT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#9E9E9E"
                    android:letterSpacing="0.10" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <Button
                        android:id="@+id/btnUrbain"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Urbain"
                        android:textColor="#C62828"
                        app:strokeColor="#C62828" />

                    <Button
                        android:id="@+id/btnAutoroute"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Autoroute"
                        android:textColor="#C62828"
                        app:strokeColor="#C62828" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Section : Heure -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="6dp"
                    android:text="HEURE DE L'INCIDENT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#9E9E9E"
                    android:letterSpacing="0.10" />

                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:timePickerMode="spinner" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Bouton Envoyer (vert urgence) ── -->
        <Button
            android:id="@+id/btnEnvoyer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="28dp"
            android:backgroundTint="#2E7D32"
            android:text="ENVOYER LE RAPPORT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.05"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>