<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 1 — Détail d'un accident -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    tools:context=".screens.IncidentDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Carte principale : icône + titre + description ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/app_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/detail_priority_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_menu_alert"
                    app:tint="@color/emergency_red" />

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accident_title_placeholder"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textColor="@color/app_text_primary"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accident_desc_placeholder"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:textColor="@color/app_text_muted"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Section label : Statut ── -->
        <TextView
            android:id="@+id/detail_photo_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photo_transmitted"
            android:textSize="11sp"
            android:textColor="@color/app_text_label"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/detail_photo_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/app_surface">

            <ImageView
                android:id="@+id/detail_photo"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:contentDescription="@string/desc_transmitted_photo"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/intervention_status"
            android:textSize="11sp"
            android:textColor="@color/app_text_label"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <!-- ── Carte statut avec boutons explicites ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/app_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/detail_status_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change_status"
                    android:textSize="14sp"
                    android:textColor="@color/app_text_muted" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/detail_status_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/status_received"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/status_received"
                        android:textAllCaps="false"
                        android:textColor="@color/emergency_red"
                        android:textSize="12sp"
                        app:strokeColor="@color/emergency_red" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/status_aid_sent"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/status_sent"
                        android:textAllCaps="false"
                        android:textColor="@color/emergency_red"
                        android:textSize="11sp"
                        app:strokeColor="@color/emergency_red" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/status_resolved"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="@string/status_resolved"
                        android:textAllCaps="false"
                        android:textColor="@color/emergency_red"
                        android:textSize="12sp"
                        app:strokeColor="@color/emergency_red" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:id="@+id/detail_status_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/timeline_received_step"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_timeline_step"
                            android:gravity="center"
                            android:text="@string/timeline_step_1"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/timeline_received_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/status_step_received"
                            android:textColor="@color/app_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/timeline_arrow_received_sent"
                        android:layout_width="24dp"
                        android:layout_height="34dp"
                        android:layout_gravity="top"
                        android:gravity="center"
                        android:text="@string/timeline_arrow"
                        android:textColor="@color/app_text_disabled"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/timeline_sent_step"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_timeline_step"
                            android:gravity="center"
                            android:text="@string/timeline_step_2"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/timeline_sent_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/status_step_sent"
                            android:textColor="@color/app_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/timeline_arrow_sent_resolved"
                        android:layout_width="24dp"
                        android:layout_height="34dp"
                        android:layout_gravity="top"
                        android:gravity="center"
                        android:text="@string/timeline_arrow"
                        android:textColor="@color/app_text_disabled"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/timeline_resolved_step"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_timeline_step"
                            android:gravity="center"
                            android:text="@string/timeline_step_3"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/timeline_resolved_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/status_step_resolved"
                            android:textColor="@color/app_text_muted"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/detail_status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_reported_prefix"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/emergency_red"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Section label : Protocole ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_protocol"
            android:textSize="11sp"
            android:textColor="@color/app_text_label"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <!-- ── Carte protocole (fond ambre doux) ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/app_warning_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_menu_alert"
                    android:layout_marginEnd="14dp"
                    app:tint="@color/app_warning" />

                <TextView
                    android:id="@+id/detail_safety_protocol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/protocol_prefix"
                    android:textSize="14sp"
                    android:textColor="@color/app_warning_text"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
